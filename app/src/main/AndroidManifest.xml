<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
 <!-- Keep the packaged app free of permissions and background entry points. -->
 <permission android:name="${applicationId}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION" tools:node="remove" />
 <uses-permission android:name="${applicationId}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION" tools:node="remove" />
 <application android:theme="@android:style/Theme.Material.Light.NoActionBar" android:label="@string/app_name" android:icon="@drawable/ic_agent" android:dataExtractionRules="@xml/data_extraction_rules" android:allowBackup="false" android:supportsRtl="true" android:usesCleartextTraffic="false">
  <activity android:name="org.k40agent.ui.MainActivity" android:exported="true">
   <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
  </activity>
  <!-- Runtime-only dependency components: remove them from the APK. Lint's compile classpath cannot resolve these removal targets; the artifact gate verifies their absence. -->
  <provider android:name="androidx.startup.InitializationProvider" android:authorities="${applicationId}.androidx-startup" tools:node="remove" tools:ignore="MissingClass" />
  <receiver android:name="androidx.profileinstaller.ProfileInstallReceiver" tools:node="remove" tools:ignore="MissingClass" />
 </application>
</manifest>
